{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omesg360bot",
  "main": "src/entry.js",
  "compatibility_date": "2026-08-16",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "REMINDERS",
        "class_name": "ReminderHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ReminderHub"]
    }
  ]
}
